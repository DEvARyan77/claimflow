<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent: manages versions of every Spring / Hibernate / Jackson / Lombok library -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.claimflow</groupId>
    <artifactId>claimflow</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>ClaimFlow</name>
    <description>Healthcare claims processing platform built with Spring Boot microservices</description>

    <properties>
        <java.version>21</java.version>
        <!--
            Spring Cloud release train that matches Spring Boot 4.1.x.
            If Maven says it cannot find spring-cloud-dependencies, open any pom.xml that
            start.spring.io generated for you (Boot 4.1.x + a Spring Cloud dependency) and copy
            its <spring-cloud.version> value here.
        -->
        <spring-cloud.version>2025.1.4</spring-cloud.version>
    </properties>

    <modules>
        <module>common/claimflow-events</module>
        <module>services/eureka-server</module>
        <module>services/config-server</module>
        <module>services/api-gateway</module>
        <module>services/patient-service</module>
        <module>services/provider-service</module>
        <module>services/claims-service</module>
        <module>services/payment-service</module>
        <module>services/notification-service</module>
        <module>services/policy-assistant-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.claimflow</groupId>
                <artifactId>claimflow-events</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
