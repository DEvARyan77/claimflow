# Copy this file to ".env" (same folder as docker-compose.yml) to switch on AI answers in the Policy Assistant.
# Without it, the assistant still works in "search-only" mode (shows the matching policy clauses).

# --- Option 1 (recommended, free): Google Gemini ---
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=paste-your-key-here

# --- Option 2: OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...

# --- Option 3: Ollama (runs on your computer, no key; needs ~4 GB free RAM) ---
# docker compose --profile ollama up -d ollama
# docker compose exec ollama ollama pull llama3.2
# docker compose exec ollama ollama pull nomic-embed-text
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://ollama:11434/v1

# Optional overrides (leave empty to use the provider's defaults)
# LLM_CHAT_MODEL=gemini-3.8-flash
# LLM_EMBEDDING_MODEL=gemini-embedding-001
# LLM_REASONING_EFFORT=low       # thinking models: low/medium/high; "off" for models that don't support it

# ================= Real email notifications =================
# Gmail: turn on 2-Step Verification, then create an App password at https://myaccount.google.com/apppasswords
MAIL_USERNAME=your.name@gmail.com
MAIL_PASSWORD=abcdefghijklmnop
# Optional: send EVERY email to this address (handy when using the demo patients, whose @example.com emails don't exist)
# NOTIFY_EMAIL_OVERRIDE=your.name@gmail.com
# Other SMTP providers: set MAIL_HOST and MAIL_PORT too
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# APP_URL=http://localhost:3000
